{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "episode_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "seed_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_file": {
      "type": "string"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "identity",
        "version",
        "config"
      ]
    },
    "inference_sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        },
        "working_directory": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      },
      "required": [
        "image",
        "platform",
        "working_directory",
        "runtime"
      ]
    },
    "verification_sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^.+@sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "enum": [
            "linux/amd64",
            "linux/arm64"
          ]
        },
        "working_directory": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      },
      "required": [
        "image",
        "platform",
        "working_directory",
        "runtime"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "identity",
        "version",
        "config",
        "timeout_seconds"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "identity",
        "version",
        "config"
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "identity",
        "version",
        "config",
        "timeout_seconds"
      ]
    },
    "inference_resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "integer",
          "minimum": 1
        },
        "storage_mb": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "cpu",
        "memory",
        "storage_mb"
      ]
    },
    "verification_resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "integer",
          "minimum": 1
        },
        "storage_mb": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "cpu",
        "memory",
        "storage_mb"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "episode_id",
    "task_id",
    "seed_digest",
    "prompt_file",
    "task",
    "inference_sandbox",
    "verification_sandbox",
    "harness",
    "candidate",
    "verifier",
    "inference_resources",
    "verification_resources",
    "metadata"
  ]
}
