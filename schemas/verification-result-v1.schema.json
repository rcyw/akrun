{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifier": {
      "type": "string"
    },
    "verifier_version": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "diagnostic_code": {
      "type": "string"
    },
    "verifier_exit_code": {
      "type": "integer"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "details": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "candidate_digest",
    "verifier",
    "verifier_version",
    "verdict",
    "diagnostic_code",
    "verifier_exit_code",
    "output_digest",
    "started_at",
    "completed_at",
    "score",
    "details"
  ]
}
